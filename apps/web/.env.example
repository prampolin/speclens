# SpecLens Local Environment Configuration
# All defaults adhere to privateMode=true and local-first execution.
# No secrets, telemetry or external services are configured here.

PORT=3000
HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Storage paths (strictly local)
SPECLENS_DATA_DIR=./data
SPECLENS_MODELS_DIR=./models
SPECLENS_SQLITE_PATH=./data/speclens.db

# Privacy enforcement
SPECLENS_PRIVATE_MODE=true

# Local Ollama service (must bind to loopback)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Environment
NODE_ENV=development
